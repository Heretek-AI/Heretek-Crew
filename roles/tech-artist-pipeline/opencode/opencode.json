{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "assets/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "tools/asset-pipeline/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gltf-transform*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "node tools/asset-pipeline/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "git_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/tech-artist-pipeline/skills"
  ],
  "plugins": [
    "opencode-mem",
    "opencode-harness"
  ],
  "mcp": {
    "servers": {
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem@1.0.0",
          "/paperclip/workspaces"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@cyanheads/git-mcp-server@2.15.3"
        ]
      }
    }
  }
}
