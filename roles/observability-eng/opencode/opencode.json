{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "deploy/prometheus/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "deploy/grafana/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "deploy/otel/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "promtool check*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "promtool test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "prometheus_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/observability-eng/skills"
  ],
  "plugins": [
    "opencode-mem",
    "opencode-harness"
  ],
  "mcp": {
    "servers": {
      "prometheus": {
        "type": "local",
        "command": [
          "uvx",
          "prometheus-mcp-server==1.6.2"
        ],
        "env": {
          "PROMETHEUS_URL": "http://prometheus:9090"
        }
      },
      "codebase-memory": {
        "type": "local",
        "command": ["npx", "-y", "codebase-memory-mcp@0.12.1"]
      }
    }
  }
}
