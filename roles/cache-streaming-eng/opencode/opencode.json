{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "schemas/events/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "src/cache/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "deploy/kafka/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "redis_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kafka_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_file_hash_read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_file_hash_edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_ast_structural_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_ast_structural_rewrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_ui_geometry_audit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_repo_map",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_blast_radius",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_file_outline",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_symbol_references",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_rename_symbol",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_verify_scoped",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_architecture_audit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_checkpoint_create",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_checkpoint_rollback",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/cache-streaming-eng/skills"
  ],
  "plugins": [
    "opencode-mem",
    "@heretek-ai/opencode-harness"
  ],
  "mcp": {
    "servers": {
      "redis": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-server-redis==0.1.1"
        ],
        "env": {
          "REDIS_URL": "redis://redis:6379"
        }
      },
      "kafka": {
        "type": "local",
        "command": [
          "uvx",
          "kafka-mcp-server==0.1.1"
        ],
        "env": {
          "KAFKA_BROKERS": "kafka:9092"
        }
      }
    }
  }
}
