{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permissions": [
    {
      "action": "fs:read",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/*.env.*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/secrets/**",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/kubeconfig*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/*.pem",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/id_rsa*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "docs/security/cloud/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "checkov -d*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tfsec*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gitleaks detect*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "aws_list*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "aws_select*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "aws_run*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "aws_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_file_hash_read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_ast_structural_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_ui_geometry_audit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_repo_map",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_blast_radius",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_file_outline",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_symbol_references",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_verify_scoped",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_architecture_audit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_checkpoint_create",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_file_hash_edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_ast_structural_rewrite",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_rename_symbol",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_checkpoint_rollback",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": "**/*.env.*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/cloud-sec-auditor/skills",
    "/roles/cloud-sec-auditor/.opencode/skills"
  ],
  "plugins": [
    "opencode-mem",
    "@heretek-ai/opencode-harness"
  ],
  "mcp": {
    "servers": {
      "aws": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "aws-mcp@1.0.2"
        ],
        "env": {
          "AWS_REGION": "${AWS_REGION:-us-east-1}"
        },
        "timeout": 5000
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "codebase-memory-mcp@0.12.1"
        ],
        "timeout": 5000
      }
    }
  }
}
