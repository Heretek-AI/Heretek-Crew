{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "docs/security/cloud/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "checkov -d*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tfsec*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gitleaks detect*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "aws_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/cloud-sec-auditor/skills"
  ],
  "plugins": [
    "opencode-mem"
  ],
  "mcp": {
    "servers": {
      "aws": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "aws-mcp"
        ],
        "env": {
          "AWS_REGION": "${AWS_REGION:-us-east-1}"
        }
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      }
    }
  }
}
