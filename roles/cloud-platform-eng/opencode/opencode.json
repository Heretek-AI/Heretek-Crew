{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "terraform/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "infra/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "tofu fmt*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tofu validate*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tofu plan*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tflint*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tofu apply*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "terraform apply*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "aws_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/cloud-platform-eng/skills"
  ],
  "plugins": [
    "opencode-mem",
    "opencode-harness"
  ],
  "mcp": {
    "servers": {
      "aws": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "aws-mcp@1.0.2"
        ],
        "env": {
          "AWS_REGION": "${AWS_REGION:-us-east-1}"
        }
      },
      "codebase-memory": {
        "type": "local",
        "command": ["npx", "-y", "codebase-memory-mcp@0.12.1"]
      }
    }
  }
}
