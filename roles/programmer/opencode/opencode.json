{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "workspaces/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "/paperclip/workspaces/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run build*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npx tsc*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npx vitest*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pytest*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "go test*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": ["zero-stub-implementation"],
  "mcp": {}
}
