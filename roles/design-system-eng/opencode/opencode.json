{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "packages/ui/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "tokens/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "src/components/ui/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm run test-storybook*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run build-tokens*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "chrome-devtools_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/design-system-eng/skills"
  ],
  "plugins": [
    "opencode-mem"
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.11.0"
        ]
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      }
    }
  }
}
