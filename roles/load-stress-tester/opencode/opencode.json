{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "tests/load/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "docs/perf/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "k6 run*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "k6_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/load-stress-tester/skills"
  ],
  "plugins": [
    "opencode-mem",
    "opencode-harness"
  ],
  "mcp": {
    "servers": {
      "k6": {
        "type": "local",
        "command": [
          "uvx",
          "k6-mcp-server"
        ]
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      }
    }
  }
}
