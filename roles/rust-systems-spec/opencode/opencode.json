{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "crates/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "src/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "tests/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "Cargo.*",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cargo build*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo clippy*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo check*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo audit*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/rust-systems-spec/skills"
  ],
  "plugins": [
    "opencode-mem"
  ],
  "mcp": {
    "servers": {
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@cyanheads/git-mcp-server"
        ]
      }
    }
  }
}
