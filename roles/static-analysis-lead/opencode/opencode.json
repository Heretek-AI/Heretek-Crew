{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*lint*",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "rules/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "biome.json",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "ruff.toml",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "semgrep --config*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npx biome check*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ruff check*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo clippy*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "semgrep_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/static-analysis-lead/skills"
  ],
  "plugins": [
    "opencode-mem"
  ],
  "mcp": {
    "servers": {
      "semgrep": {
        "type": "local",
        "command": [
          "semgrep",
          "mcp",
          "--transport",
          "stdio"
        ]
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      }
    }
  }
}
