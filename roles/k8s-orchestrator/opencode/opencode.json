{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permissions": [
    {
      "action": "fs:read",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/*.env.*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/secrets/**",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/kubeconfig*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/*.pem",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**/id_rsa*",
      "effect": "deny"
    },
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "deploy/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "k8s/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "helm lint*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "helm template*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "kubeconform*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "kubectl diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "kubectl apply*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "kubectl delete*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_kubectl_get*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_kubectl_describe*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_kubectl_previous_logs*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_kubectl_exec*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "kubernetes_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "docker_list*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "docker_get*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "docker_create*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "docker_deploy*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "docker_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_file_hash_read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_file_hash_edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_ast_structural_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_ast_structural_rewrite",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_ui_geometry_audit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_repo_map",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_blast_radius",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_file_outline",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_symbol_references",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_rename_symbol",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_verify_scoped",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_architecture_audit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_checkpoint_create",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_checkpoint_rollback",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "fs:write",
      "resource": "**/*.env.*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/k8s-orchestrator/skills",
    "/roles/k8s-orchestrator/.opencode/skills"
  ],
  "plugins": [
    "opencode-mem",
    "@heretek-ai/opencode-harness"
  ],
  "mcp": {
    "servers": {
      "kubernetes": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-server-kubernetes==0.1.6"
        ],
        "env": {
          "KUBECONFIG": "/kubeconfig/kubeconfig-readonly"
        },
        "timeout": 5000
      },
      "docker": {
        "type": "local",
        "command": [
          "uvx",
          "docker-mcp==0.2.0"
        ],
        "env": {
          "DOCKER_HOST": "tcp://docker-socket-proxy:2375"
        },
        "timeout": 5000
      }
    }
  }
}
