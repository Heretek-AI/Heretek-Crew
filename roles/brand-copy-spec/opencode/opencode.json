{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "locales/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "docs/brand/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "git_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "filesystem_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "harness_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/brand-copy-spec/skills"
  ],
  "plugins": [
    "opencode-mem",
    "opencode-harness"
  ],
  "mcp": {
    "servers": {
      "git": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@cyanheads/git-mcp-server"
        ]
      },
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/paperclip/workspaces"
        ]
      }
    }
  }
}
