{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "permissions": [
    {
      "action": "fs:read",
      "resource": "**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "src/engine/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "tests/engine/**",
      "effect": "allow"
    },
    {
      "action": "fs:write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cargo bench*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo test engine*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cmake --build*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ctest*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "codebase-memory_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "skills": [
    "/roles/engine-systems-eng/skills"
  ],
  "plugins": [
    "opencode-mem"
  ],
  "mcp": {
    "servers": {
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ]
      },
      "git": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@cyanheads/git-mcp-server"
        ]
      }
    }
  }
}
