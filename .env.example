# Heretek-Crew environment template.
# Copy to .env and fill in secrets:  cp .env.example .env
# NEVER commit .env. NEVER bake these values into a Docker image.
# BEFORE `make up`: replace EVERY CHANGE_ME__ placeholder below with a fresh
# generated secret -- compose fails closed (refuses to start) until you do,
# and the shipped defaults are NOT usable credentials.
#
# Generate strong secrets with:
#   openssl rand -base64 48   # BETTER_AUTH_SECRET
#   openssl rand -base64 32   # PAPERCLIP_TOOL_ACTION_SIGNING_SECRET
#   openssl rand -base64 24   # POSTGRES_PASSWORD (avoid @ / : # ? & — they break DATABASE_URL)

# --- Image selection -------------------------------------------------------
# Official Paperclip base image tag built from /tmp/paperclip (when building locally):
#   docker build -t paperclip:official-local /tmp/paperclip
PAPERCLIP_BASE_IMAGE=paperclip:official-local

# Prebuilt container image used by docker-compose.prebuilt.yml (never unpinned :latest):
# Wave 3 P1-9: semver form :1.0.0 (the workflow never mints :v1.0.0).
# HERETEK_IMAGE=ghcr.io/heretek-ai/heretek-crew:1.0.0

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=CHANGE_ME__openssl_rand_base64_24
POSTGRES_DB=paperclip
# DATABASE_URL is assembled by docker-compose.yml from the parts above, e.g.:
#   postgres://paperclip:<POSTGRES_PASSWORD>@postgres:5432/paperclip

# --- Paperclip server ------------------------------------------------------
PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Required. Session/auth encryption secret (min 32 chars recommended).
BETTER_AUTH_SECRET=CHANGE_ME__openssl_rand_base64_48
# Optional but recommended in production. Independent secret for signed
# approval-gated tool actions; empty disables signature verification.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=CHANGE_ME__openssl_rand_base64_32

# UID/GID the container remaps the `node` user to at startup (default 1000).
USER_UID=1000
USER_GID=1000

# --- Model provider API keys (at least one required) -----------------------
# Consumed by OpenCode v2 provider auth inside agent runs.
#
# OpenCode Zen / Console / Go:
# OPENCODE_API_KEY provides unified access to OpenCode Console, OpenCode Zen (opencode/*),
# and OpenCode Go (opencode-go/*) models (subscribe at https://opencode.ai/zen or console).
OPENCODE_API_KEY=
# Dedicated subscription key for OpenCode Go (if using a distinct key from OPENCODE_API_KEY):
# OPENCODE_GO_API_KEY=

# Standard commercial providers:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional extras (uncomment as needed):
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# AZURE_OPENAI_API_KEY=

# --- Reverse proxy profile (`docker compose --profile proxy up`) -----------
# Public hostname caddy requests automatic TLS for, e.g. crew.example.com.
# Empty default is fine: default `docker compose config` / `up` (without
# --profile proxy) parses with PROXY_DOMAIN empty or unset. Set PROXY_DOMAIN
# only when using --profile proxy; when unset, caddy falls back to
# `localhost` (no public TLS).
PROXY_DOMAIN=

# --- Tailscale profile (`docker compose --profile tailscale up`) ------------
# Ephemeral auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=heretek-paperclip
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:heretek --accept-routes
TS_EXTRA_ARGS=--advertise-tags=tag:heretek

# --- Sidecars: Web Research Profile (`--profile web-research`) -------------
# Firecrawl NuQ database credentials (REQUIRED for web-research profile;
# compose fails closed without them — no working defaults are shipped).
#   openssl rand -base64 24   # FIRECRAWL_DB_PASSWORD (avoid @ / : # ? &)
# FIRECRAWL_DB_USER=firecrawl
FIRECRAWL_DB_PASSWORD=CHANGE_ME__openssl_rand_base64_24

# SearXNG session secret (REQUIRED for web-research profile).
#   openssl rand -base64 48
SEARXNG_SECRET=CHANGE_ME__openssl_rand_base64_48

# --- Sidecars: Browser / AI Gateway / Graph / S3 profiles -------------------
# All REQUIRED when their profile is enabled; compose fails closed without
# them. Generate with: openssl rand -hex 32 (tokens) / openssl rand -base64 24 (passwords).
# Browserless token (web-research, qa-testing profiles):
BROWSERLESS_TOKEN=CHANGE_ME__openssl_rand_hex_32
# Neo4j password (ai-gateway profile):
NEO4J_PASSWORD=CHANGE_ME__openssl_rand_base64_24
# LiteLLM master key (ai-gateway profile):
LITELLM_MASTER_KEY=CHANGE_ME__sk_openssl_rand_hex_32
# MinIO root credentials (qa-testing, core profiles):
MINIO_ROOT_USER=CHANGE_ME__minio_admin_user
MINIO_ROOT_PASSWORD=CHANGE_ME__openssl_rand_base64_24

# --- Wave 4 hardening secrets (P1-4 Redis, P1-10 Qdrant) ---
# Password enforced by BOTH redis services via --requirepass (P1-4,
# CVE-2025-49844 follow-through: network auth, not just a version bump).
# Fail-closed: compose :? guards + authed healthchecks refuse to start
# without it. Avoid @ / : # ? & and spaces (embedded in REDIS_URLs).
#   openssl rand -base64 24   # (URL-safe charset as above)
REDIS_PASSWORD=CHANGE_ME__openssl_rand_base64_24
# API key enforced by qdrant via QDRANT__SERVICE__API_KEY (P1-10/P1-6).
# The vector-rag-spec MCP server sends it as QDRANT_API_KEY (same value).
#   openssl rand -hex 32
QDRANT_API_KEY=CHANGE_ME__openssl_rand_hex_32

# --- Wave 2 provisioning: MCP credential scoping (P0-2/P0-3 + P1-8) ---
# These three values close the MCP<->shell escape mitigations that were
# cited but unprovisioned (dba read-only URL, github token, read-only
# kubeconfig). Compose :? guards + the seed-50 preflight refuse to run
# until all three are real (no working defaults are shipped).
# Password for the TRUE read-only paperclip_reader role, provisioned at
# first boot by scripts/postgres-init-readonly-role.sh (SELECT-only grants
# + default_transaction_read_only=on + connection limit).
#   openssl rand -base64 24   # (avoid @ / : # ? & — it is embedded in a URL)
POSTGRES_READER_PASSWORD=CHANGE_ME__openssl_rand_base64_24
# Connection URI for paperclip_reader, consumed by dba-specialist's postgres
# MCP server. MUST use the paperclip_reader user (seed-50 rejects superuser
# URLs); the password MUST match POSTGRES_READER_PASSWORD above.
POSTGRES_READONLY_URL=CHANGE_ME__postgres_readonly_role_url
# Scoped personal access token for the 7 github-backed roles
# (exec-director, product-director, tpm-scrum-lead, compliance-auditor,
# release-qa-officer, threat-modeler, ux-research-analyst). Least privilege:
# read-only scopes (public_repo, or repo-read for private orgs), limited to
# the fleet repositories. Never an admin/owner token.
GITHUB_TOKEN=CHANGE_ME__github_token_pat
# Host path of a kubeconfig whose current context is bound to a READ-ONLY
# ClusterRole (e.g. view, without secrets access). Bind-mounted read-only to
# /paperclip/secrets/kubeconfig-readonly for k8s-orchestrator. The seed-50
# preflight requires this path to be a regular file (fail-closed). Keep it
# under ./secrets/ (gitignored) — NEVER commit cluster credentials.
KUBECONFIG_READONLY_PATH=./secrets/kubeconfig-readonly
